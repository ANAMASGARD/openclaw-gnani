{
  "name": "openclaw-plugin-gnani",
  "version": "0.1.0",
  "description": "OpenClaw provider plugin for Gnani AI Speech.",
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run --config ./vitest.config.ts",
    "validate": "npm run build && clawhub package validate . --out .clawhub-validation",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "openclaw plugins lint --root .",
    "test:live": "npm run build && node tests/live.mjs",
    "test:e2e": "node tests/gateway.mjs"
  },
  "files": [
    "dist",
    "openclaw.plugin.json",
    "README.md",
    "docs",
    "examples",
    "LICENSE"
  ],
  "peerDependencies": {
    "openclaw": "2026.11.5"
  },
  "peerDependenciesMeta": {
    "openclaw": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/ws": "^8.18.2",
    "clawhub": "0.26.0",
    "openclaw": "2026.11.5",
    "typescript": "7.0.2",
    "vite": "8.3.8",
    "vitest": "5.1.1"
  },
  "openclaw": {
    "extensions": [
      "./dist/index.js"
    ],
    "compat": {
      "pluginApi": "2026.11.5"
    },
    "build": {
      "openclawVersion": "2026.11.5"
    },
    "install": {
      "clawhubSpec": "clawhub:openclaw-plugin-gnani",
      "defaultChoice": "clawhub",
      "minHostVersion": ">=2026.11.5"
    },
    "release": {
      "publishToClawHub": true
    }
  },
  "pluginInspector": {
    "version": 1,
    "plugin": {
      "id": "gnani",
      "priority": "high",
      "seams": [
        "plugin-runtime"
      ],
      "sourceRoot": ".",
      "expect": {
        "registrations": [
          "registerMediaUnderstandingProvider",
          "registerRealtimeTranscriptionProvider",
          "registerSpeechProvider"
        ]
      }
    }
  },
  "dependencies": {
    "ws": "^8.23.0"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  },
  "engines": {
    "node": ">=24.16.0 <25 || >=26.1.0"
  },
  "license": "MIT",
  "exports": {
    "./batch": {
      "types": "./dist/stt/batch.d.ts",
      "default": "./dist/stt/batch.js"
    },
    "./tts-websocket": {
      "types": "./dist/tts/websocket.d.ts",
      "default": "./dist/tts/websocket.js"
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ANAMASGARD/openclaw-gnani.git"
  }
}
