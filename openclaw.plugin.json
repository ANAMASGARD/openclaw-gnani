{
  "id": "gnani",
  "name": "Gnani AI Speech",
  "description": "Prisma transcription and Timbre speech synthesis for OpenClaw.",
  "version": "0.1.0",
  "categories": ["voice"],
  "activation": { "onStartup": true },
  "setup": {
    "providers": [{ "id": "gnani", "envVars": ["GNANI_API_KEY"] }]
  },
  "contracts": {
    "mediaUnderstandingProviders": ["gnani"],
    "realtimeTranscriptionProviders": ["gnani"],
    "speechProviders": ["gnani"]
  },
  "mediaUnderstandingProviderMetadata": {
    "gnani": { "capabilities": ["audio"], "defaultModels": { "audio": "prisma-v3.0" } }
  },
  "configSchema": { "type": "object", "additionalProperties": false, "properties": {} }
}
